asan = False

Dockerfile:
  use_cache = True
  base_image = @Cuda12_1_0Cudnn8DevelUbuntu22_04
  registry = "nvcr.io/nvidian/legion"

XlaExtension:
  repo = "git@github.com:nv-legate/xla.git"
  branch = "legate-main"
  copy_image = True
  system_nccl = "2.18.5"
  system_nccl = "2.17.1"

Legion:
  copy_image = True
  version = "23.09.0"
  ucx = True
  asan = %asan
  max_dim = 5

LegateXla:
  branch = "main"
  copy_image = True
  prototype = False
  asan = %asan
  editable = True

Legate:
  repo = "git@github.com:nv-legate/legate.core.internal"
  #branch = "cpp-branch-23.09"
  copy_image = True
  commit = "b039ca21e7bb165409e494e8b2566917ec41d33e"

Jaxlib:
  repo = "git@github.com:nv-legate/jax.git"
  copy_image = True
  provider = @Repo

Jax:
  repo = "git@github.com:nv-legate/jax.git"
  copy_image = True
  provider = @Repo
  editable = True

Repo:
  skip_existing = True

Legere:
  use_global_rc = False
  include_utils = True

Python:
  version = "3.11"

