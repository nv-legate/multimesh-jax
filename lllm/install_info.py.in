# IMPORTANT:
#   * install_info.py is a generated file and should not be modified by hand

def get_libpath():
    import os, sys, platform
    join = os.path.join
    exists = os.path.exists
    dirname = os.path.dirname
    lllm_path = dirname(dirname(__file__))
    so_ext = {
        "": "",
        "Java": ".jar",
        "Linux": ".so",
        "Darwin": ".dylib",
        "Windows": ".dll"
    }[platform.system()]

    def find_liblgllm(libdir):
        if exists(join(libdir, f"liblgllm{so_ext}")):
            return libdir
        return None

    return (
        find_liblgllm(join(lllm_path, "build", "lib")) or
        find_liblgllm(join(dirname(dirname(dirname(lllm_path))), "lib")) or
        find_liblgllm(join(dirname(dirname(sys.executable)), "lib")) or
        ""
    )


libpath: str = get_libpath()
header: str = """@header@"""
