import legate_tasks
import paxml.trainer_lib

ClientConfig:
  auto_shard = True
  disable_gc = True # this is the control-replication problem
  configurable = @legate_tasks.LambadaConfig

LambadaConfig:
  transformer_num_devices = 8
  logits_num_devices = 8
  embeddings_num_devices = 8
  layers_per_stage = 2
  layers_per_interleave = None

MicrobatchConfig:
  size = 8
