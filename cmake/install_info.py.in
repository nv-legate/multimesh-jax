#   * install_info.py is a generated file and should not be modified by hand

def get_libpath():
    import os, sys, platform
    join = os.path.join
    exists = os.path.exists
    dirname = os.path.dirname
    lllm_path = dirname(dirname(__file__))
    cpp_build_root = "@PROJECT_SOURCE_DIR@"
    so_ext = {
        "": "",
        "Java": ".jar",
        "Linux": ".so",
        "Darwin": ".dylib",
        "Windows": ".dll"
    }[platform.system()]

    def find_lib(libdir):
        if exists(join(libdir, f"@libname@{so_ext}")):
            return libdir
        return None

    return (
        find_lib(join(lllm_path, "build", "lib")) or
        find_lib(join(cpp_build_root, "lib")) or
        find_lib(join(dirname(dirname(dirname(lllm_path))), "lib")) or
        find_lib(join(dirname(dirname(sys.executable)), "lib")) or
        ""
    )


libpath: str = get_libpath()
header: str = """@header@"""
