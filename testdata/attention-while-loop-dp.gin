from lllm import mesh


MB_AXES = [
  ("heads", "ax"),
]

POST_MB_AXES = [
  ("batch", "ax"),
  ("heads", "ax"),
]

TASK_MESH = (2,)

COMMON_ARGS = {
  "device_axes" : ('ax',),
  "device_shape" : %TASK_MESH,
}

MB_ARGS = (%COMMON_ARGS, {
  "num_layers" : 2,
  "logical_axes" : %MB_AXES,
})

POST_MB_ARGS = (%COMMON_ARGS, {
  "num_layers" : 2,
  "logical_axes" : %POST_MB_AXES,
})


ScheduleConfig:
  num_layers = 2
  num_gangs = 2
  forward_cost = 1
  backward_cost = 3

to_combine = {
  "layer_1" : ["layer_1", "logits", "loss"],
}
key_utils.CombineNamesTransform:
  to_combine = %to_combine


key_utils.CompressLayersTransform:
  num_layers = 4
  num_layers_per_key = 2

map_legate_key:
  transforms = [
   (@key_utils.CompressLayersTransform,()),
   (@key_utils.CombineNamesTransform,()),
  ]

legate_global_mesh:
  mesh_args = [
    (@mesh.LayerMesh, "layer_{}[.]post-microbatch.*", %POST_MB_ARGS),
    (@mesh.LayerMesh, "layer_{}.*", %MB_ARGS),
  ]
  debug_mode = True

ScheduleConfig:
  num_layers = 2
  num_gangs = 1
  num_microbatches = 3
  forward_cost = 1
  backward_cost = 3




