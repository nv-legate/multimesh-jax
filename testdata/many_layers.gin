from lllm import mesh
from lllm import key_utils

NUM_LAYERS = 2

LOGICAL_AXES = [
  ("x", "ax0"),
  ("y", "ax1"),
]

MESH_ARGS = {
  "num_layers" : %NUM_LAYERS,
  "device_axes" : ('ax0', 'ax1'),
  "logical_axes" : %LOGICAL_AXES,
  "device_shape" : (1,1),
}

legate_global_mesh:
  mesh_args = [
    (@mesh.LayerMesh, "layer_{}.*?", (%MESH_ARGS,)),
  ]

key_utils.CompressLayersTransform:
  num_layers_per_key = 2

map_legate_key:
  transforms = [
    (@key_utils.CompressLayersTransform, ()),
  ]




