from lllm import mesh


NUM_LAYERS = 2

FORWARD_AXES = [
  ("batch", "ax0"),
  ("x", "ax0"),
  ("z", "ax1"),
  ("z", "ax0"),
]

MESH_ARGS = {
  "num_layers" : %NUM_LAYERS,
  "device_axes" : ('ax0', 'ax1'),
  "logical_axes" : %FORWARD_AXES,
  "device_shape" : (1,1),
}

legate_global_mesh:
  mesh_args = [
    (@mesh.LayerMesh, "layer_{}.*", (%MESH_ARGS,)),
  ]





