from lllm import mesh


NUM_LAYERS = 2

LOGICAL_AXES = [
  ("x", "ax0"),
  ("y", "ax1"),
]

MESH_ARGS = {
  "device_axes" : ("ax0", "ax1"),
  "logical_axes" : %LOGICAL_AXES,
  "num_layers" : %NUM_LAYERS,
  "device_shape" : (1,1)
}


legate_global_mesh:
  mesh_args = [
    (@mesh.LayerMesh, "layer_{}.*?", (%MESH_ARGS,))
  ]





